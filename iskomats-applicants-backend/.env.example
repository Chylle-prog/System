# Supabase Configuration
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
SUPABASE_STORAGE_BUCKET=your_storage_bucket_name
STORE_FILES_IN=your_storage_mode

# Database Configuration
DB_NAME=your_database_name
DB_USER=postgres.your_project_ref
DB_PASSWORD=your_db_password
DB_HOST=aws-1-your-region.pooler.supabase.com
DB_PORT=your_database_port
DB_SCHEMA=your_database_schema
DB_SSLMODE=your_database_ssl_mode
DB_CONNECT_TIMEOUT=your_database_connect_timeout

# Security
SECRET_KEY=your_secret_key_here
ENCRYPTION_KEY=your_fernet_encryption_key_here

# Frontend Origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:5174,https://cozy-kulfi-35f772.netlify.app,https://stingy-body.surge.sh,https://foregoing-giants.surge.sh,https://iskomats-admin.surge.sh,https://system-kjbv.onrender.com
FRONTEND_URL=https://iskomats-admin.surge.sh
STUDENT_FRONTEND_URL=https://foregoing-giants.surge.sh
PASSWORD_RESET_EXPIRY_MINUTES=30

# Gmail API / Password Reset Email
GOOGLE_CLIENT_ID=your_google_oauth_client_id
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret
GOOGLE_REFRESH_TOKEN=your_google_refresh_token
GMAIL_SENDER_EMAIL=your_gmail_address@gmail.com

# Admin Dashboard Specific
ADMIN_PASSWORD=your_admin_password_here

# SMS Notifications
# Set SMS_PROVIDER to the provider you want to use: 'twilio', 'semaphore', or 'itexmo'
# Leave unset or set to 'none' to disable SMS notifications
SMS_PROVIDER=none

# Twilio (global provider, free trial available at twilio.com)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_FROM_NUMBER=+1XXXXXXXXXX

# ITEXMO (Philippines-local, affordable - sign up at itexmo.com)
ITEXMO_EMAIL=your_itexmo_account_email
ITEXMO_PASSWORD=your_itexmo_account_password
ITEXMO_API_CODE=your_itexmo_api_code

# Semaphore (Philippines-local)
SEMAPHORE_API_KEY=your_semaphore_api_key
SEMAPHORE_SENDER_NAME=ISKOMATS
